APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use the same host + port as you type in the browser (e.g. http://127.0.0.1:8000). Do not mix localhost vs 127.0.0.1
# or session cookies will not match and form submits can return 419 Page Expired.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=laravel
 DB_USERNAME=root
 DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use reverb for realtime chat (run `php artisan reverb:start` alongside the app). Use log/null if not needed.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSockets for realtime chat). Generate keys with `php artisan reverb:install` or reuse app defaults.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="admin123"

# OCR.space API key (citizen ID extraction). Leave empty to fill the form manually.
# Free key: https://ocr.space/ocrapi
# OCR_SPACE_API_KEY=
# Use one code (eng, ara) or auto with Engine 2 — not comma-separated.
# OCR_SPACE_LANGUAGE=auto

# Optional English hints for Arabic ID fields (LibreTranslate public instance).
# LIBRETRANSLATE_ENABLED=true
# LIBRETRANSLATE_URL=https://libretranslate.com

# Set to true only on local/staging to show "Skip 2FA" on citizen 2FA screens. Never in production.
# CITIZEN_ALLOW_2FA_SKIP=false

# Set to true only on local dev to skip the ID verification redirect/gate for citizens. Never in production.
# CITIZEN_SKIP_IDENTITY_VERIFICATION=false